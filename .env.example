# SIH26006 Freight Forecasting - example environment
# Copy to `.env` and edit. `.env` is gitignored and never committed.
#
# This project needs NO API keys. Every data source it uses is keyless:
# Mendeley, IMF PortWatch, Yahoo Finance and Open-Meteo. The entry below
# is optional and the pipeline runs fine without it.

# FRED (US Federal Reserve economic data). Free, instant, no card.
# https://fredaccount.stlouisfed.org/apikey
# Only adds MONTHLY IMF coal and iron ore series. Brent and USD/INR
# already arrive DAILY from Yahoo, so this is a nice-to-have.
FRED_API_KEY=

# Interface the app binds to. Loopback by default so a dev server is not
# exposed to the network. Hosted platforms usually require 0.0.0.0.
HOST=127.0.0.1

# Port the app binds to. Hosted platforms inject their own.
PORT=5000

# Werkzeug's debugger allows arbitrary code execution on any machine that
# can reach the port, so this defaults to False and must stay False on
# anything network-reachable. Set True only for local development.
FLASK_DEBUG=False
